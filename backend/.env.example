# --- Database -----------------------------------------------------------
# Switch databases by changing ONE variable. No code changes required.
#
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./lifeforge.db
#
# PostgreSQL (needs `uv sync --group postgres`, driver psycopg3):
# DATABASE_URL=postgresql+psycopg://lifeforge:lifeforge@localhost:5432/lifeforge

# --- Security -----------------------------------------------------------
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP ---------------------------------------------------------------
# JSON list of allowed browser origins for CORS.
CORS_ORIGINS=["http://localhost:3000"]

# --- Dev convenience -----------------------------------------------------
# Create tables automatically on startup (use Alembic in production).
AUTO_CREATE=true
